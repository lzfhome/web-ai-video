# ===== 作品产物（源码 + build + deliveries，全部不进 git） =====
workspaces/vibe-knowledge/projects/

# ===== 构建/中间产物 =====
**/build/
**/.build/
**/frames/
**/stills/
**/node_modules/
**/.venv/
**/venv/
**/__pycache__/
*.pyc
*.pyo
*.log

# ===== 密钥与敏感配置 =====
**/config.secrets.json
**/*.env
!**/*.env.example
**/mimo.env

# ===== video-studio 本地数据 =====
tools/video-studio/data/
tools/video-studio/*.bak.json
tools/video-studio/config.example.json

# ===== 上游仓库：保留源码，跳过重媒体 =====
repos/**/*.mp4
repos/**/*.mov
repos/**/*.wav
repos/**/*.m4a
repos/**/*.gif

# ===== 参考资料里的重媒体（要版本化请用 Git LFS） =====
resources/references/**/*.mp4
resources/references/**/*.mov
resources/references/**/*.wav
resources/references/**/*.m4a
resources/references/**/*.png
resources/references/**/*.jpg
resources/references/**/*.jpeg
resources/references/**/*.webp
resources/references/**/*.gif
resources/references/**/*.doc
resources/references/**/*.docx
resources/references/**/*.pdf
resources/references/**/*.ppt
resources/references/**/*.pptx
resources/references/**/*.xls
resources/references/**/*.xlsx
resources/references/**/*.zip
resources/references/**/*.rar
resources/references/**/*.7z

# ===== 大体积音乐源文件（FLAC 只留本地；入库只留 MP3） =====
resources/music/**/*.flac
resources/music/_incoming/

# ===== 队列锁 / 引擎临时输出 =====
**/.queue.lock
cine/audio/generated/

# 本会话下载的 Node/ffmpeg/benchmark 工具链，放仓库内但不入库
tools/local/

# ===== 系统 =====
.DS_Store
Thumbs.db
*.sid
opencode.sid
opencode.list
