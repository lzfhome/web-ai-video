# ===== 输出（临时 + 成品，全部不进 git） =====
out/

# ===== 构建/中间产物 =====
**/build/
**/.build/
**/frames/
**/stills/
**/node_modules/
**/.venv/
**/venv/
**/__pycache__/
*.pyc
*.pyo
*.log

# ===== 密钥与敏感配置 =====
**/config.secrets.json
**/*.env
!**/*.env.example
**/mimo.env

# ===== video-studio 本地数据 =====
tools/video-studio/data/
tools/video-studio/*.bak.json
tools/video-studio/config.example.json

# ===== 上游仓库：保留源码，跳过重媒体 =====
repos/**/*.mp4
repos/**/*.mov
repos/**/*.wav
repos/**/*.m4a
repos/**/*.gif

# ===== 参考资料里的重媒体（要版本化请用 Git LFS） =====
resources/references/**/*.mp4
resources/references/**/*.mov
resources/references/**/*.wav
resources/references/**/*.m4a

