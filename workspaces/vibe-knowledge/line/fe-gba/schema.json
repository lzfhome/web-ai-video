{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fe-gba work.json",
  "type": "object",
  "required": ["title", "story", "style", "shots"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "source": { "type": "string" },
    "story": { "type": "string", "minLength": 10 },
    "style": { "type": "string", "minLength": 10 },
    "style_lock": { "type": "string" },
    "characters": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "story", "action", "camera", "video_prompt", "duration", "resolution", "ratio", "seed"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "title": { "type": "string" },
          "story": { "type": "string", "minLength": 10 },
          "reference_images": {
            "type": "array",
            "items": { "type": "string" },
            "maxItems": 10
          },
          "keyframe": { "type": "string" },
          "last_frame": { "type": "string" },
          "keyframe_prompt": { "type": "string" },
          "keyframe_model": { "type": "string" },
          "keyframe_size": { "type": "string" },
          "video_prompt": { "type": "string", "minLength": 40 },
          "video": { "type": "string" },
          "model": { "type": "string" },
          "max_takes": { "type": "integer", "const": 1 },
          "action": {
            "type": "object",
            "required": ["start", "middle", "end"],
            "properties": {
              "start": { "type": "string" },
              "middle": { "type": "string" },
              "end": { "type": "string" }
            }
          },
          "camera": { "type": "string", "minLength": 3 },
          "mode": { "enum": ["first_frame", "reference", "text"] },
          "duration": { "type": "integer", "minimum": 4, "maximum": 30 },
          "resolution": { "enum": ["480p", "720p", "1080p", "4k"] },
          "ratio": { "enum": ["16:9", "4:3", "1:1", "3:4", "9:16", "21:9", "adaptive"] },
          "seed": { "type": "integer", "minimum": 0 },
          "generate_audio": { "type": "boolean" }
        }
      }
    }
  }
}
